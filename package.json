{
  "name": "webcockpit",
  "version": "0.1.18",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:prod": "playwright test -c playwright.prod.config.ts",
    "bench": "node bench/text-bench.ts && node bench/script-bench.ts && node bench/browser-bench.ts",
    "typecheck": "tsc --noEmit",
    "build:pages": "node scripts/pages-build.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "preact": "10.29.8"
  }
}
