#nop Khazdul: a PvP profile for MUME, bundled with WebCockpit as a reference.
#nop It shows how aliases, actions, macros and variables work together.
#nop HELP in the profile editor explains every command used here.

#nop ---- State ----
#nop A variable declared here is saved back to the profile when a script
#nop changes it, so target, class, spell and doors survive a reload.

#variable {target} {*elf*}
#variable {character} {Rasta}
#variable {class} {caster}
#variable {spell} {'hold'}
#variable {ss} {normal}
#variable {sd1} {exit}
#variable {sd2} {way}
#variable {sd3} {}
#variable {weap1} {hewer}
#variable {weap2} {engraved}
#variable {weap3} {engraved}
#variable {body} {tunic}
#variable {abody} {mantle}
#variable {ring} {copperring}
#variable {acontainer} {quiver}
#variable {arrow} {arrow}

#nop ---- Feedback helpers ----
#nop Aliases starting with _ are helpers called by other aliases. Each one
#nop prints a state variable with #showme: label in sand, value in white.

#alias {_show_class} {#showme {<F9AA8B7>## CLASS: <FFFFFFF>$class<099>}}
#alias {_show_spell_speed} {#showme {<F9AA8B7>## SPELL-SPEED: <FFFFFFF>$ss<099>}}
#alias {_show_acontainer} {#showme {<F9AA8B7>## ARROW CONTAINER: <FFFFFFF>$acontainer  <F9AA8B7>(ammo: <FFFFFFF>$arrow<F9AA8B7>)<099>}}

#alias {_show_spell} {
    #if {"$spell" != ""} {
        #showme {<F9AA8B7>## SPELL: <FFFFFFF>$spell<099>}
    };
    #else {
        #showme {<F9AA8B7>## SPELL: <099>(none)}
    }
}

#nop ---- Target and character ----
#nop With an argument the alias stores it. Either way it shows the value.

#alias {z} {
    #if {"%1" != ""} {
        #variable {target} {%1}
    };
    #if {"$target" != ""} {
        #showme {<F9AA8B7>## TARGET: <FFFFFFF>$target<099>}
    };
    #else {
        #showme {<F9AA8B7>## TARGET: <099>(none)}
    }
}

#alias {bear} {z *bear*}
#alias {dwarf} {z *dwarf*}
#alias {elf} {z *elf*}
#alias {helf} {z *half-elf*}
#alias {hobbit} {z *hobbit*}
#alias {man} {z *man*}
#alias {orc} {z *orc*}
#alias {troll} {z *troll*}

#nop char names the character your followers protect and rescue (op, or).

#alias {char} {
    #if {"%1" != ""} {
        #variable {character} {%1}
    };
    #if {"$character" != ""} {
        #showme {<F9AA8B7>## CHAR: <FFFFFFF>$character<099>}
    };
    #else {
        #showme {<F9AA8B7>## CHAR: <099>(none)}
    }
}

#nop ---- Class and combat keys ----
#nop The class aliases set $class. F2 to F4 branch on it, so the same keys
#nop work for every character.

#alias {caster} {#variable {class} {caster}; _show_class}
#alias {thief} {#variable {class} {thief}; _show_class}
#alias {warcaster} {#variable {class} {warcaster}; _show_class}
#alias {warrior} {#variable {class} {warrior}; _show_class}

#macro {F1} {hit $target}

#macro {F2} {
    #if {"$class" == "warrior"} {
        bash $target
    };
    #elseif {"$class" == "caster" || "$class" == "warcaster"} {
        cast $ss $spell $target
    };
    #elseif {"$class" == "thief"} {
        backstab $target
    }
}

#macro {F3} {
    #if {"$class" == "warrior"} {
        bash
    };
    #elseif {"$class" == "caster" || "$class" == "warcaster"} {
        cast $ss $spell
    };
    #elseif {"$class" == "thief"} {
        shoot
    }
}

#macro {F4} {
    #if {"$class" == "warrior" || "$class" == "warcaster"} {
        kick
    };
    #elseif {"$class" == "caster" || "$class" == "thief"} {
        shoot $target
    }
}

#macro {F5} {draw $weap1}
#macro {F6} {draw $weap2}
#macro {F7} {draw $weap3}

#nop ---- Spells ----
#nop Each alias picks the spell that F2 and F3 cast. The text after the
#nop alias name is passed on to _spell, which reads it as %0.

#alias {_spell} {#variable {spell} {%0}; _show_spell}

#alias {bh} {_spell 'burning hands'}
#alias {blind} {_spell 'blindness'}
#alias {bolt} {_spell 'lightning bolt'}
#alias {charm} {_spell 'charm'}
#alias {chill} {_spell 'chill touch'}
#alias {clight} {_spell 'call lightning'}
#alias {ct} {_spell 'chill touch'}
#alias {disp} {_spell 'dispel evil'}
#alias {edrain} {_spell 'energy drain'}
#alias {fball} {_spell 'fireball'}
#alias {fireball} {_spell 'fireball'}
#alias {grasp} {_spell 'shocking grasp'}
#alias {harm} {_spell 'harm'}
#alias {hold} {_spell 'hold'}
#alias {mm} {_spell 'magic missile'}
#alias {silence} {_spell 'silence'}
#alias {sleep} {_spell 'sleep'}
#alias {smo} {_spell 'smother'}
#alias {smoth} {_spell 'smother'}
#alias {smother} {_spell 'smother'}
#alias {spray} {_spell 'colour spray'}
#alias {ss} {_spell 'sleep'}

#nop Casting speed, used as $ss by the casts.

#alias {car} {#variable {ss} {careful}; _show_spell_speed}
#alias {fast} {#variable {ss} {fast}; _show_spell_speed}
#alias {norm} {#variable {ss} {normal}; _show_spell_speed}
#alias {normal} {#variable {ss} {normal}; _show_spell_speed}
#alias {quick} {#variable {ss} {quick}; _show_spell_speed}
#alias {thor} {#variable {ss} {thoroughly}; _show_spell_speed}

#nop Pattern aliases: b1, b2, b12 ... blind that number of the target, and
#nop s1, s2 ... put it to sleep. %+1..d is one or more digits, and the
#nop digits become %1.

#alias {^b%+1..d$} {cast $ss 'blindness' %1.$target}
#alias {^s%+1..d$} {cast $ss 'sleep' %1.$target}
#alias {qeq} {cast n 'earthquake'}

#nop ---- Doors ----
#nop sd sets up to three door names and shows them. It builds the line
#nop in a scratch variable, one part for each door that is set.

#alias {sd} {
    #if {"%1" != ""} {
        #variable {sd1} {%1};
        #if {"%2" != ""} {
            #variable {sd2} {%2}
        };
        #if {"%3" != ""} {
            #variable {sd3} {%3}
        }
    };
    #variable {_sd_line} {};
    #if {"$sd1" != ""} {
        #variable {_sd_line} {$_sd_line<F9AA8B7> SD1: <FFFFFFF>$sd1}
    };
    #if {"$sd2" != ""} {
        #variable {_sd_line} {$_sd_line<F9AA8B7>  SD2: <FFFFFFF>$sd2}
    };
    #if {"$sd3" != ""} {
        #variable {_sd_line} {$_sd_line<F9AA8B7>  SD3: <FFFFFFF>$sd3}
    };
    #if {"$_sd_line" != ""} {
        #showme {<F9AA8B7>##$_sd_line<099>}
    };
    #else {
        #showme {<F9AA8B7>## (no spam doors set)<099>}
    }
}

#alias {dx} {sd exit %1}

#alias {o} {open $sd1}
#alias {od} {open $sd1 d}
#alias {oe} {open $sd1 e}
#alias {os} {open $sd1 s}
#alias {ou} {open $sd1 u}
#alias {ow} {open $sd1 w}
#alias {oo} {unlock $sd1; open $sd1}
#alias {3} {open $sd2}

#alias {c} {close $sd1}
#alias {cd} {close $sd1 d}
#alias {ce} {close $sd1 e}
#alias {cs} {close $sd1 s}
#alias {cu} {close $sd1 u}
#alias {cw} {close $sd1 w}
#alias {cc} {close $sd1; lock $sd1}
#alias {2} {close $sd2}

#alias {ld} {lock $sd1 d}
#alias {le} {lock $sd1 e}
#alias {ls} {lock $sd1 s}
#alias {lu} {lock $sd1 u}
#alias {lw} {lock $sd1 w}

#alias {ud} {unlock $sd1 d}
#alias {ue} {unlock $sd1 e}
#alias {us} {unlock $sd1 s}
#alias {uu} {unlock $sd1 u}
#alias {uw} {unlock $sd1 w}

#alias {pd} {pick $sd1}
#alias {ped} {pick $sd1 d}
#alias {pe} {pick $sd1 e}
#alias {ps} {pick $sd1 s}
#alias {pu} {pick $sd1 u}
#alias {pw} {pick $sd1 w}

#alias {bd} {cast n 'block door' $sd1}
#alias {bdd} {cast q 'block door' $sd1}
#alias {bed} {cast n 'block door' $sd1 d}
#alias {be} {cast n 'block door' $sd1 e}
#alias {bs} {cast n 'block door' $sd1 s}
#alias {bu} {cast n 'block door' $sd1 u}
#alias {bw} {cast n 'block door' $sd1 w}

#alias {rook} {get rock pack; use rock $sd1 %1}
#alias {cb} {close board; lock board}
#alias {ub} {unbar exit w; open exit w}

#nop ---- Followers ----

#alias {of} {order followers %0}
#alias {aa} {order followers assist}
#alias {ok} {order followers hit $target}
#alias {op} {order followers protect $character}
#alias {or} {order followers rescue $character}
#alias {oft} {order followers flush t}
#alias {obh} {order followers cast 'burning hands'}
#alias {obt} {order followers cast 'burning hands' $target}
#alias {olb} {order followers cast 'lightning bolt'}
#alias {olbt} {order followers cast 'lightning bolt' $target}
#alias {ab} {order bb bash}
#alias {bt} {order bb bash $target}

#nop ---- Movement, tracking and hiding ----

#alias {ed} {escape down}
#alias {ee} {escape east}
#alias {en} {escape north}
#alias {es} {escape south}
#alias {eu} {escape up}
#alias {ew} {escape west}

#alias {td} {track donkey}
#alias {tm} {track mule}
#alias {tp} {track pack}
#alias {trd} {track dales}
#alias {trt} {track $target}
#alias {tt} {track trained}

#alias {tw} {
    #if {"$target" == "*orc*"} {
        track warg
    };
    #else {
        track warhorse
    }
}

#alias {hf} {hide fast}
#alias {hn} {hide normal}
#alias {hq} {hide quick}
#alias {ht} {hide thorough}

#alias {lm} {label m}
#alias {lordf} {w; s; w; s; w; w; n; w; n; n}

#nop ---- Equipment ----
#nop _eq_body and _eq_ring swap the worn item for the one named and
#nop remember it, so a second call with the same item does nothing.

#alias {_eq_body} {
    #if {"%1" != "$abody"} {
        #if {"$abody" != ""} {
            rem $abody
        };
        get %1 pack;
        wear %1;
        #if {"$abody" != ""} {
            put $abody pack
        };
        #variable {abody} {%1}
    }
}

#alias {bhc} {_eq_body hooded}
#alias {fgc} {_eq_body forest}
#alias {forest} {_eq_body forest}
#alias {fur} {_eq_body fur}
#alias {grey} {_eq_body fine-grey-cloak}
#alias {mantle} {_eq_body mantle}
#alias {ragged} {_eq_body ragged}
#alias {sacred} {_eq_body sacred}
#alias {silvery} {_eq_body fur-cloak}
#alias {soot} {_eq_body soot}
#alias {tainted} {_eq_body tainted-grey-cloak}
#alias {woven} {_eq_body woven}

#alias {_eq_ring} {
    #if {"%1" != "$ring"} {
        #if {"$ring" != ""} {
            rem $ring
        };
        get %1 sable;
        wear %1;
        #if {"$ring" != ""} {
            put $ring sable
        };
        #variable {ring} {%1}
    }
}

#alias {ccr} {_eq_ring garnet-ring}
#alias {db} {_eq_ring sapphire}
#alias {iron} {_eq_ring ironring}
#alias {mana} {_eq_ring golden-ruby-ring}
#alias {ob} {_eq_ring rubyring}
#alias {opal} {_eq_ring opal-ring}
#alias {rempr} {_eq_ring emerald-ring}
#alias {sp} {_eq_ring copperring}
#alias {strr} {_eq_ring topaz-ring}
#alias {wooden} {_eq_ring wooden}

#nop Body armour. The actions keep $body in step with what the game says
#nop is worn, and the aliases remove that before wearing the next piece.

#action {^You wear a fine metal breastplate on your body.$} {#variable {body} {plate}}
#action {^You wear a shining breastplate on your body.$} {#variable {body} {plate}}
#action {^You wear a shining chain mail shirt on your body.$} {#variable {body} {shirt}}
#action {^You wear a coarse dusky robe on your body.$} {#variable {body} {robe}}
#action {^You wear a frayed tunic on your body.$} {#variable {body} {tunic}}
#action {^You wear a grey tunic on your body.$} {#variable {body} {tunic}}
#action {^You wear an ebony tunic on your body.$} {#variable {body} {tunic}}
#action {^You are already wearing an ebony tunic on your body.$} {#variable {body} {tunic}}

#alias {plate} {rem $body; wear plate}
#alias {robe} {rem $body; wear robe}
#alias {shirt} {rem $body; wear shirt}
#alias {tunic} {rem $body; wear tunic}

#alias {circlet} {rem helm; wear circlet}
#alias {crown} {rem helmet; wear crown}
#alias {helm} {rem circlet; wear helmet}
#alias {hood} {rem crown; wear hood}
#alias {boots} {rem boots; wear 2.boots}
#alias {gloves} {rem gloves; wear 2.gloves}

#nop ---- Arrows and bolts ----
#nop acontainer picks quiver or case and sets the matching ammo word.

#alias {acontainer} {
    #if {"%1" == "quiver" || "%1" == "case"} {
        #variable {acontainer} {%1};
        #if {"$acontainer" == "quiver"} {
            #variable {arrow} {arrow}
        };
        #else {
            #variable {arrow} {bolt}
        };
        _show_acontainer
    };
    #else {
        #if {"%1" != ""} {
            #showme {<F9AA8B7>## ERROR: acontainer must be 'quiver' or 'case'<099>}
        };
        #else {
            _show_acontainer
        }
    }
}

#alias {case} {acontainer case}
#alias {quiver} {acontainer quiver}

#alias {ga} {get all.$arrow; put all.$arrow $acontainer}
#alias {aq} {get all.ash pack; put all.ash quiver}
#alias {as} {get all.ash quiver; put all.ash pack}
#alias {wq} {get all.fletched pack; put all.fletched quiver}
#alias {ws} {get all.fletched quiver; put all.fletched pack}

#nop ---- Scrolls, potions and items ----
#nop Text after a scroll alias is passed on as the target: azure 2.orc

#alias {_scroll} {get %1 all; recite %0}

#alias {azure} {_scroll azurescroll}
#alias {black} {_scroll blackscroll}
#alias {blue} {_scroll bluescroll}
#alias {ebony} {_scroll ebonyscroll}
#alias {purple} {_scroll purplescroll}
#alias {vellum} {_scroll vellumscroll}
#alias {rs} {recite scroll}

#alias {miruvor} {get miruvor pack; quaff miruvor}
#alias {qd} {get draught pack; quaff draught}
#alias {qdd} {get zaugurz-draught pack; quaff zaugurz-draught}
#alias {powd} {use powder}

#nop ---- Puzzle ----

#alias {a1} {
    push forostar north;
    push orrostar east;
    push hyarrostar southeast;
    push hyarnustar southwest;
    push andustar west;
    push mittalmar center
}

#alias {a2} {
    push forostar east;
    push orrostar southeast;
    push hyarrostar southwest;
    push hyarnustar west;
    push andustar north;
    push mittalmar center
}

#alias {a3} {
    push forostar southeast;
    push orrostar southwest;
    push hyarrostar west;
    push hyarnustar north;
    push andustar east;
    push mittalmar center
}

#alias {a4} {
    push forostar southwest;
    push orrostar west;
    push hyarrostar north;
    push hyarnustar east;
    push andustar southeast;
    push mittalmar center
}

#alias {a5} {
    push forostar west;
    push orrostar north;
    push hyarrostar east;
    push hyarnustar southeast;
    push andustar southwest;
    push mittalmar center
}

#nop ---- Actions ----
#nop %1 captures text for the commands. A braced group is a regular
#nop expression, here matching either word.

#action {^%1 raises {his|her} hand.$} {group %1}
#action {WARNING} {sc}

#nop ---- Highlights and substitutes ----
#nop A capitalised colour name is the bright variant. A substitute
#nop rewrites the line: %0 is the matched text and <Frrggbb> colours it.

#highlight {- armour} {Cyan}
#highlight {- breath of briskness} {Cyan}
#highlight {- detect magic} {Cyan}
#highlight {- protection from evil} {Cyan}
#highlight {- shield} {Cyan}
#highlight {- shroud} {Cyan}
#highlight {- strength} {Cyan}
#highlight {- sanctuary} {Magenta}
#highlight {- stored spell %1} {magenta}
#highlight {- shadow-link} {Green}
#highlight {- spectral health} {Green}
#highlight {- comfortable} {green}
#highlight {- very comfortable} {green}
#highlight {- heavy burden} {red}
#highlight {- lethargy} {red}
#highlight {- tiredness} {red}
#highlight {A pair of tiny eyes gleam at you from the shadows.} {Cyan}
#highlight {AA} {green}
#highlight {BB} {green}
#highlight {CC} {green}
#highlight {DD} {green}
#highlight {MIN} {cyan}

#substitute {^%1 seems to be blinded!} {<F23aaee>%0}
#substitute {^-%1wound%2} {<Fff0000>%0}
