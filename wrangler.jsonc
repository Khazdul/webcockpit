// The Cloudflare Worker that serves WebCockpit (ADR 0144, spec §7.1):
// the static build (`npm run build:site` → dist-site/) and the API under
// /api/*. The top level is production; `--env staging` is the staging
// Worker. Production answers at mumecockpit.com (a custom domain:
// Cloudflare makes the DNS record and the certificate); both also answer
// on workers.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webcockpit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  // No usage metrics to Cloudflare from wrangler, here or in CI.
  "send_metrics": false,
  "workers_dev": true,
  "routes": [{ "pattern": "mumecockpit.com", "custom_domain": true }],
  "assets": {
    "directory": "dist-site",
    "binding": "ASSETS",
    // Only the API runs Worker code; every file is served without it.
    "run_worker_first": ["/api/*"],
    // Unknown paths answer 404 with 404.html, as on GitHub Pages
    // (`/r/<id>` comes in stage 64).
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "staging": {
      "name": "webcockpit-staging",
      // Not inherited: the domain belongs to production alone.
      "routes": [],
      "workers_dev": true
    }
  }
}
