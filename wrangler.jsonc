// The Cloudflare Worker that serves WebCockpit (ADR 0144, spec §7.1):
// the static build (`npm run build:site` → dist-site/), the API under
// /api/*, the admin page under /admin (ADR 0148) and the usage statistics'
// cron (ADR 0147). The top level is production; `--env staging` is the
// staging Worker. Production answers at mumecockpit.com, staging at
// staging.mumecockpit.com (custom domains: Cloudflare makes the DNS record
// and the certificate); both also answer on workers.dev.
//
// Bindings, vars and ratelimits are not inherited by an environment, so
// env.staging repeats them with its own names. `routes` and `triggers` are
// inherited, so staging sets its own.
//
// The D1 ids come from the by-hand workflow provision.yml (stage 59).
// Local development and the tests do not need real ids (wrangler dev keys
// its local database by the id, whatever it is).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webcockpit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  // No usage metrics to Cloudflare from wrangler, here or in CI.
  "send_metrics": false,
  "workers_dev": true,
  "routes": [{ "pattern": "mumecockpit.com", "custom_domain": true }],
  "assets": {
    "directory": "dist-site",
    "binding": "ASSETS",
    // Only the API, the admin page and the watch page run Worker code;
    // every other file is served without it. `/admin` and `/admin/*` both,
    // as the docs do not promise that `/admin*` matches `/admin`. `/r/*`
    // (stage 64, ADR 0154): `/r/<id>` answers the site's index.html, and a
    // file under /r/ (the frame document) is handed to the assets as it is.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/r/*"],
    // Unknown paths answer 404 with 404.html, as on GitHub Pages.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    // Server flags' defaults (ADR 0147, addendum): production dark; a row
    // in the D1 table `flag`, set from /admin, overrides it.
    "FLAG_STATS": false,
    // Accounts, sync and runs in the cloud open together in production
    // (owner, 2026-11-15, after stage 63's test on staging; release 0.12.0).
    "FLAG_ACCOUNTS": true,
    "FLAG_SYNC": true,
    "FLAG_RUNS": true,
    // Share links (stage 64, ADR 0154): open in production on the
    // owner's go-ahead after his test on staging (2026-11-15, release 0.13.0).
    "FLAG_SHARE": true,
    // The community (stage 65, ADR 0155): listing, the Community page,
    // stars, comments and the counters (`gallery`), Random Runes (`runes`).
    // Off in production until the owner's go-ahead after his test on staging.
    "FLAG_GALLERY": false,
    "FLAG_RUNES": false,
    // Accounts (ADR 0145, "As built"). The Turnstile widget `WebCockpit`
    // (the owner, 2026-11-14; hostnames mumecockpit.com and
    // staging.mumecockpit.com): its site key, public by nature, and the
    // host a passed challenge must come from.
    // Two secrets are set outside the repository (the dashboard, or
    // `wrangler secret put`), never here: AUTH_PEPPER (random, at least 16
    // characters; e.g. `openssl rand -base64 32`; changing it later only
    // resets the attempt counters and the fake salts) and
    // TURNSTILE_SECRET (the widget's secret key). Without either, the
    // account endpoints answer 503 accounts_not_configured.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGAnAvI_uOP5cZND",
    "TURNSTILE_HOSTNAMES": "mumecockpit.com",
    // Cloudflare Access (ADR 0148, addendum): the team domain
    // (`<team>.cloudflareaccess.com`) and the application's audience tag,
    // filled in after the owner has made the Access application. Empty:
    // /admin answers 503 admin_not_configured. The secret ADMIN_EMAILS is
    // set in the dashboard.
    "ACCESS_TEAM_DOMAIN": "flat-unit-c1f3.cloudflareaccess.com",
    "ACCESS_AUD": "8171e8c6972c3e28805fa694a0c2597b5e05ce9a2788da35bcc0bd4da7ebec34",
    // The owner's mail on each report (worker/mail.ts, ADR 0154 "As
    // built ... mail on reports"): sent from this address on the zone
    // (Email Routing is on) to the secret REPORT_MAIL_TO, a verified
    // destination address, set outside the repository (`wrangler secret
    // put REPORT_MAIL_TO`). Without the secret no mail is sent. The links
    // in a mail use SITE_ORIGIN.
    "REPORT_MAIL_FROM": "reports@mumecockpit.com",
    "SITE_ORIGIN": "https://mumecockpit.com"
  },
  // No destination here: an unrestricted binding sends to any verified
  // destination address of the account, so the owner's address stays out
  // of git (notes/research/cloudflare-email.md).
  "send_email": [{ "name": "REPORT_MAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webcockpit",
      // From provision.yml (run 43537875273, 2026-11-14).
      "database_id": "c0cd2544-0e45-4782-9053-da20a9233d74",
      "migrations_dir": "worker/migrations"
    }
  ],
  // R2: run bodies under u/<account>/ (stage 63), published payloads under pub/ (stage 64).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "webcockpit", "jurisdiction": "eu" }],
  // POST /api/beat, keyed by address (ADR 0147). A page beats every 5
  // minutes and on a state change; 30 a minute leaves room for a
  // household or a school behind one address.
  // /api/auth/* and /api/u/*, keyed by address and by session (spec §7.10):
  // 120 a minute.
  "ratelimits": [
    { "name": "BEAT_LIMITER", "namespace_id": "5901", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "5903", "simple": { "limit": 120, "period": 60 } },
    // POST /api/auth/login, /recover and /register, keyed by address (an
    // IPv6 /64 is one): each can cost a database write or a Turnstile call.
    { "name": "AUTH_LIMITER", "namespace_id": "5905", "simple": { "limit": 10, "period": 60 } },
    // GET /api/gallery?q= (a search), keyed by address, besides API_LIMITER:
    // a text no one asked in the last minute reads every listed run.
    { "name": "SEARCH_LIMITER", "namespace_id": "5907", "simple": { "limit": 20, "period": 60 } }
  ],
  // The usage statistics (worker/stats.ts): a sample every 5 minutes; the
  // roll-up of the previous day and pruning at 00:10 UTC.
  "triggers": { "crons": ["*/5 * * * *", "10 0 * * *"] },
  "env": {
    "staging": {
      "name": "webcockpit-staging",
      "routes": [{ "pattern": "staging.mumecockpit.com", "custom_domain": true }],
      "workers_dev": true,
      "vars": {
        "FLAG_STATS": true,
        "FLAG_ACCOUNTS": true,
        "FLAG_SYNC": true,
        "FLAG_RUNS": true,
        "FLAG_SHARE": true,
        "FLAG_GALLERY": true,
        "FLAG_RUNES": true,
        // The same widget as production (see the top level); the secrets
        // TURNSTILE_SECRET and AUTH_PEPPER are set on this Worker too.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGAnAvI_uOP5cZND",
        "TURNSTILE_HOSTNAMES": "staging.mumecockpit.com",
        "ACCESS_TEAM_DOMAIN": "flat-unit-c1f3.cloudflareaccess.com",
        "ACCESS_AUD": "8171e8c6972c3e28805fa694a0c2597b5e05ce9a2788da35bcc0bd4da7ebec34",
        // Every answer of the Worker carries X-Robots-Tag: noindex; the
        // static files get it from the `_headers` rule that
        // `build:site --target staging` adds.
        "NOINDEX": true,
        // The reports' mail (see the top level); a staging mail says
        // "[staging]" in its subject (NOINDEX).
        "REPORT_MAIL_FROM": "reports@mumecockpit.com",
        "SITE_ORIGIN": "https://staging.mumecockpit.com"
      },
      "send_email": [{ "name": "REPORT_MAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webcockpit-staging",
          // From provision.yml (run 43537875273, 2026-11-14).
          "database_id": "7739f9cf-ee96-42fb-b6da-68797f69fd9a",
          "migrations_dir": "worker/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "webcockpit-staging", "jurisdiction": "eu" }],
      "ratelimits": [
        { "name": "BEAT_LIMITER", "namespace_id": "5902", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "5904", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "5906", "simple": { "limit": 10, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "5908", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": { "crons": ["*/5 * * * *", "10 0 * * *"] }
    }
  }
}
